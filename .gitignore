# Scratch and patch files.
# These were once patch_*, fix_* and *.txt at the repository root, which is far
# too broad — a bare "*.txt" silently swallows any legitimate text file anyone
# adds, anywhere, with no warning. Anchored to the root and narrowed.
/patch_*
/fix_*
/scratch_*
.vscode/

# Signing material and certificates. *.jks and *.keystore are covered above;
# this is the general form of the certificate rule, which used to name one file.
*.pem
*.p12

# goldie renders the store assets from goldie/goldie.config.ts and the raw
# device captures; both the captures and the finished tiles are large binaries
# that can be regenerated, so only the config is tracked.
goldie/out/
goldie/hi/out/
