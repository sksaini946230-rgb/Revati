<?xml version="1.0" encoding="utf-8"?>
<!--
    Auto Backup rules for API 30 and below. The API 31+ equivalent lives in
    data_extraction_rules.xml; see the note there for why birth data is excluded,
    and why there are two preference files rather than one.
-->
<full-backup-content>
    <exclude domain="database" path="astroveda_database" />
    <exclude domain="database" path="astroveda_database-shm" />
    <exclude domain="database" path="astroveda_database-wal" />
    <exclude domain="sharedpref" path="astroveda_prefs.xml" />
    <!-- LanguageManager's separate file, missed by the original list. -->
    <exclude domain="sharedpref" path="astro_prefs.xml" />
    <!-- The wrapped SQLCipher passphrase; useless off this device, and not worth carrying. -->
    <exclude domain="sharedpref" path="revati_db_key.xml" />
</full-backup-content>
